# CurseForge packaging rules
# Retained for repository-packager compatibility. The canonical release flow
# uploads the verified GitHub release archive through the CurseForge workflow.

# Ignore all non-addon directories and repository metadata
ignore:
  - .agents
  - .gemini
  - .git
  - .gitattributes
  - .github
  - .gitignore
  - .tools
  - .versions
  - .vscode
  - Images
  - AGENTS.md
  - CHANGELOG.md
  - docs
  - README.md
  - package.json
  - package-lock.json
  - RELEASE_NOTES.md
  - TEMP_NOTES.md
